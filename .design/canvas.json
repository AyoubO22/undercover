  "annotations": [
    { "id": "note-ecrans", "page": "page-1", "x": 0, "y": -330, "w": 620,
      "text": "ÉCRAN PRINCIPAL\nCe qui change par rapport au site actuel :\n· lampe de bureau tramée au-dessus du guichet\n· grille de haut-parleur sous la vitre, plaque « GUICHET N° 4 »\n· sous-main vert aux coins usés, trace de tasse, stylo\n· tampons en manche de bois plutôt qu'en boutons plats\n· trombone sur la note de service" },
    { "id": "note-mobile", "page": "page-2", "x": 0, "y": -230, "w": 480,
      "text": "MOBILE\nAucune fausse barre iOS : le téléphone dessine la sienne par-dessus.\nLes papiers passent en pleine largeur et s'empilent ; les deux tampons\ntiennent la moitié de la barre du bas (cible tactile ≥ 44 px)." },
    { "id": "note-specs", "page": "page-3", "x": 0, "y": -230, "w": 560,
      "text": "SPÉCIFICATIONS\nValeurs à reprendre telles quelles.\nRègle absolue : aucun rayon d'arrondi, aucune ombre floue,\ndes bordures de 2 px, des ombres décalées à 45°." }
  ],
